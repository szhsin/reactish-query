{
  "name": "reactish-query",
  "version": "0.8.2",
  "description": "Atomic state-powered, lightweight React query library",
  "author": "Zheng Song",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/szhsin/reactish-query.git"
  },
  "type": "module",
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.mjs",
  "types": "./types/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist/",
    "types/",
    "composable/",
    "middleware/"
  ],
  "keywords": [
    "react",
    "query",
    "state",
    "data fetching"
  ],
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "require": "./dist/cjs/index.cjs",
      "default": "./dist/esm/index.mjs"
    },
    "./composable": {
      "types": "./types/composable/index.d.ts",
      "require": "./dist/cjs/composable/index.cjs",
      "default": "./dist/esm/composable/index.mjs"
    },
    "./middleware": {
      "types": "./types/middleware/index.d.ts",
      "require": "./dist/cjs/middleware/index.cjs",
      "default": "./dist/esm/middleware/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "start": "run-p watch \"types -- --watch\"",
    "bundle": "rolldown -c",
    "watch": "rolldown -w -c",
    "types": "tsc",
    "clean": "rm -Rf dist types",
    "prepare": "rm -Rf types/__tests__",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "pret": "prettier -c .",
    "pret:fix": "prettier -w .",
    "build": "run-s pret clean types lint bundle",
    "test": "vitest run",
    "eg": "npm run dev --prefix examples"
  },
  "peerDependencies": {
    "react": "^16.14 || ^17 || ^18 || ^19"
  },
  "dependencies": {
    "reactish-state": "^2.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-istanbul": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/eslint-plugin": "^1.6.23",
    "deplift": "^1.3.0",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-hooks-addons": "^0.5.1",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.9.5",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "rolldown": "^1.1.5",
    "rollup-plugin-add-directive": "^1.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0",
    "vitest": "^4.1.10"
  }
}
